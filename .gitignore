# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Plugin marketplace MCP servers (under plugins/) — explicit globs
# (covered above by `node_modules` and `dist`, but spelled out so a future
# PR adding a build step under plugins/ can't accidentally commit artefacts).
plugins/mcp-servers/*/node_modules/
plugins/mcp-servers/*/dist/
plugins/mcp-servers/*/*.tsbuildinfo

# Next.js
.next/
out/
next-env.d.ts
*.tsbuildinfo

# Environment
.env*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Claude Code local state — never commit
.claude/

# macOS Finder duplicate artefacts (e.g. "PricingPage 2.tsx")
* [0-9].*
* [0-9][0-9].*

# Backup files left from manual swaps
*.legacy-rgb
*.bak
*.orig
