{
  "manifest_version": 3,
  "name": "assembl Kitchen · New World pilot",
  "description": "Review New World products and approve individual trolley additions from your kitchen plan. Checkout is always yours.",
  "version": "0.1.0",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "scripting"],
  "optional_host_permissions": ["https://www.newworld.co.nz/*", "https://kitchen-machine-kate.katecoveny.chatgpt.site/*"],
  "background": {"service_worker": "worker.js", "type": "module"},
  "action": {"default_title": "Open Kitchen shopping companion"},
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"}
}
