{
  "$schema": "https://json.schemastore.org/vercel.json",
  "framework": "nextjs",
  "ignoreCommand": "case \"$VERCEL_GIT_COMMIT_REF\" in assets/*|pr-assets/*|*shots*|*screenshots*|*screens*) exit 0;; esac; git diff --quiet HEAD^ HEAD -- . ':(exclude)plugins/'",
  "crons": [
    {
      "path": "/api/spark/winter-series/ingest",
      "schedule": "0 17 * * 1"
    },
    {
      "path": "/api/business-pulse/scheduled",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/dash/payouts/run",
      "schedule": "0 2 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/echo-demo",
      "destination": "/echo-dashboard.html",
      "permanent": false
    }
  ]
}
