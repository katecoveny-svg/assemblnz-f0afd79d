{
  "$schema": "https://json.schemastore.org/vercel.json",
  "framework": "nextjs",
  "installCommand": "corepack enable && pnpm install",
  "ignoreCommand": "bash scripts/vercel-ignore.sh",
  "crons": [
    {
      "path": "/api/spark/winter-series/ingest",
      "schedule": "0 17 * * 1"
    },
    {
      "path": "/api/business-pulse/scheduled",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/dash/payouts/run",
      "schedule": "0 2 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/echo-demo",
      "destination": "/echo-dashboard.html",
      "permanent": false
    }
  ]
}
