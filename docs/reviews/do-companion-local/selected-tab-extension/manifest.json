{
  "manifest_version": 3,
  "name": "DO selected page — read only",
  "version": "1.9.0",
  "description": "Explicit image and selected-text snapshots for your DO conversation. No page actions.",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "scripting",
    "sidePanel"
  ],
  "host_permissions": [
    "https://www.assembl.co.nz/*"
  ],
  "action": {
    "default_title": "Connect this selected page to DO",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "background": {
    "service_worker": "worker.js"
  }
}
