 require(all(isinstance(x,dict) and set(x)=={'database','collate','ctype','encoding','provider','icu_locale','locale_version'} for x in rows),'locale evidence shape mismatch')
 require([x['database'] for x in rows]==list(names),'locale database identity/order mismatch')
 require(all(x['collate']=='en_US.UTF-8' and x['ctype']=='en_US.UTF-8' and x['encoding']=='UTF8' and x['provider']=='i' and x['icu_locale']=='en-US' and x['locale_version']==(None if x['database']=='template0' else '153.121') and isinstance(x['ctype'],str) and x['ctype'] for x in rows),'fixture locale/encoding/provider mismatch')
