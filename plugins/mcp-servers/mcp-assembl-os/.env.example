# Assembl application that exposes /api/mcp-bridge
ASSEMBL_BASE_URL=http://127.0.0.1:3000

# Public canonical URL of this MCP resource server. Production must be HTTPS.
ASSEMBL_MCP_PUBLIC_URL=http://127.0.0.1:8787

# Production default: OAuth. The incoming Supabase OAuth access token is
# forwarded to the Assembl bridge, which verifies identity + workspace access.
ASSEMBL_MCP_AUTH_MODE=oauth

# Supabase OAuth authorization-server issuer. If omitted, the MCP server derives
# this from NEXT_PUBLIC_SUPABASE_URL by appending /auth/v1.
ASSEMBL_MCP_AUTHORIZATION_SERVER=https://YOUR_PROJECT.supabase.co/auth/v1
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Writes are OFF by default. Even when true, the current write tools create
# proposed internal work / pending approvals only. They never dispatch directly.
ASSEMBL_MCP_WRITES_ENABLED=false

# Hosted request allowlists. Missing Origin is allowed for server-to-server MCP clients.
ASSEMBL_MCP_ALLOWED_HOSTS=localhost,127.0.0.1
ASSEMBL_MCP_ALLOWED_ORIGINS=http://localhost:6274

# ---- Local Inspector fallback only -----------------------------------------
# Set ASSEMBL_MCP_AUTH_MODE=dev-token if you have not enabled Supabase OAuth yet.
# The client token protects /mcp. The separate bridge token protects the app API.
ASSEMBL_MCP_CLIENT_TOKEN=replace-with-a-long-random-client-secret
ASSEMBL_MCP_BRIDGE_TOKEN=replace-with-a-different-long-random-bridge-secret
ASSEMBL_MCP_TENANT=assembl
ASSEMBL_MCP_ACTOR=mcp-dev
# Required in the Assembl web app only when using the legacy bridge token.
ASSEMBL_MCP_ALLOW_LEGACY_BRIDGE_TOKEN=false

HOST=127.0.0.1
PORT=8787
