# Assembl application that exposes /api/mcp-bridge
ASSEMBL_BASE_URL=http://127.0.0.1:3000

# One workspace per private-alpha MCP deployment.
# Multi-tenant customer auth moves to OAuth 2.1 before production use.
ASSEMBL_MCP_TENANT=assembl
ASSEMBL_MCP_ACTOR=chatgpt

# Shared only between this MCP process and the Assembl app bridge.
ASSEMBL_MCP_BRIDGE_TOKEN=replace-with-a-long-random-secret

# Private-alpha client protection for MCP Inspector or clients that support a bearer header.
ASSEMBL_MCP_CLIENT_TOKEN=replace-with-a-different-long-random-secret

# Writes are OFF by default. When true, write tools still create only internal
# proposed work or pending human approvals; they never dispatch directly.
ASSEMBL_MCP_WRITES_ENABLED=false

# Never enable anonymous mode against real customer data. It exists only for
# a non-sensitive demo tenant when testing a no-auth MCP client.
ASSEMBL_MCP_ALLOW_ANONYMOUS=false

# Set these in hosted environments. Missing Origin is allowed for server-to-server clients.
ASSEMBL_MCP_ALLOWED_HOSTS=localhost,127.0.0.1
ASSEMBL_MCP_ALLOWED_ORIGINS=http://localhost:6274

HOST=127.0.0.1
PORT=8787
