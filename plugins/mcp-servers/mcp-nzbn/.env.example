# NZBN API key (Ocp-Apim-Subscription-Key)
#
# The NZBN public API at https://api.business.govt.nz/services/v5/nzbn/entities
# is a public register but the gateway requires a free subscription key for
# rate-limiting. Register at https://api.business.govt.nz/ to obtain one.
#
# Without this key, the server still starts and the tools surface a clean
# "NZBN_API_KEY not configured" error rather than crashing.

NZBN_API_KEY=

# Optional override for the API base URL.
# Default: https://api.business.govt.nz/services/v5/nzbn
NZBN_API_BASE_URL=
