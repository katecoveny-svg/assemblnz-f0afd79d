# Companies Office API key (Ocp-Apim-Subscription-Key)
#
# The NZ Companies Office register data is published via the business.govt.nz
# API gateway. The basic registry-search endpoints are publicly accessible
# but the gateway requires a free subscription key for rate-limiting.
# Register at https://api.business.govt.nz/ to obtain one.
#
# Some deeper endpoints (full director/shareholder histories, document downloads)
# may require an additional Companies Office API key. Where that's the case,
# the tools surface a clean
#   "this endpoint requires a Companies Office API key"
# error rather than crashing.

COMPANIES_OFFICE_API_KEY=

# Optional override for the API base URL.
# Default: https://api.business.govt.nz/services/v1/companies
COMPANIES_OFFICE_API_BASE_URL=
