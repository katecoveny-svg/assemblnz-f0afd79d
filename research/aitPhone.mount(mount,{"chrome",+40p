/* The yes. */
.accept{display:grid;grid-template-columns:1.35fr 1fr;gap:26px;margin-top:52px;
  border:1px solid var(--accent);border-radius:22px;padding:34px;position:relative;overflow:hidden;
  background:linear-gradient(150deg,rgba(var(--film),.06),rgba(var(--film),.02))}
.accept::before{content:"";position:absolute;inset:0;pointer-events:none;
