/* What a pilot needs from you. */
.needs{display:grid;grid-template-columns:repeat(auto-fit,minmax(310px,1fr));gap:0 34px;margin-top:30px}
.need{display:flex;gap:16px;padding:19px 0;border-bottom:1px solid var(--line-2)}
