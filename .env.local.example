# ────────────────────────────────────────────────────────────────────────────
# .env.local — local dev only. NEVER commit .env.local.
# Vercel project env holds the production values; copy them down for local
# dev (Vercel CLI: `vercel env pull .env.local`).
# ────────────────────────────────────────────────────────────────────────────

# Canonical assembl-prod Supabase project (project ref: wurwcrgxjjwqdaxqceey,
# Sydney region). Confirmed by Kate 2026-05-09 — the project name carries the
# "Lovable" lineage but it IS the live assembl-prod where Vercel auth, edge
# functions, and migrations all run today.
# Get these values from Supabase Studio → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL="https://wurwcrgxjjwqdaxqceey.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
# Service-role key — server-only (NEVER exposed to the browser). Used by the
# agent free-tier counter + entitlement checks and other admin reads. Without it
# those server routes fail open (free messages aren't persisted). Set in Vercel.
SUPABASE_SERVICE_ROLE_KEY=""

# Optional — founder gate cookie passphrase for /dashboard/vessel-studio.
# Out of scope for the Supabase auth wiring.
# FOUNDER_GATE_SECRET=""

# ── Hui meeting agent ─────────────────────────────────────────────
# Audio transcription provider (Deepgram). Without this key, Hui's
# upload/record tabs show "coming online soon" and the paste-transcript
# path stays fully live. LLM + evidence-pack rendering reuse the existing
# Supabase edge functions (no extra key needed).
DEEPGRAM_API_KEY=""
# Force-disable transcription even if a key is present (rollout flag).
HUI_TRANSCRIPTION_PROVIDER_CONFIGURED=""

# ── Agent marketplace chat (Vercel AI SDK) ────────────────────────
# Per-agent streaming chat (/agents/[slug]/chat) calls Anthropic via the Vercel
# AI SDK. Without this key the chat route returns a friendly 503 and the rest of
# the marketplace (browse + detail) stays fully live. OpenAI key is optional —
# only needed if an agent's model tier is later re-pointed at an OpenAI model.
ANTHROPIC_API_KEY=""
# OPENAI_API_KEY=""
#
# Free-fallback model ladder (lib/ai/router.ts). The agent keeps answering when
# the primary errors/rate-limits: Anthropic → Gemini 2.5 Flash → Groq Llama 3.3
# → local Ollama. Each rung is used only if its key is set, so these are all
# optional — but at least one model key (above or below) is required for chat.
# GEMINI_API_KEY=""                 # or GOOGLE_GENERATIVE_AI_API_KEY
# GROQ_API_KEY=""
# OLLAMA_BASE_URL=""                # e.g. http://localhost:11434/v1 (on-prem only)
# CLAUDE_SKILLS_ENABLED="false"     # skill router primary (lib/ai/skill-router.ts)

# ── HAPAI lead capture → Brevo mailing list ───────────────────────
# When a visitor adds their email at a HAPAI tool's gating wall, the lead is
# subscribed to the single assembl mailing list in Brevo (the ESP already
# running this stack — the notify leg uses it too). Both vars must be set or the
# Brevo leg is a silent no-op — leads still land in Supabase (hapai_leads /
# lead_inquiries) and the assembl inbox regardless. NOTE: Brevo's "Authorised
# IPs" setting must allow serverless egress (or be off) for this leg to land.
BREVO_API_KEY=""
BREVO_LIST_ID=""
# Optional: a dedicated list for Atlas readiness-report leads (so the weekly
# follow-up can be segmented). Falls back to BREVO_LIST_ID when unset.
BREVO_ATLAS_READINESS_LIST_ID=""

# ── Per-agent email (inbound + outbound) ──────────────────────────
# Premium agents (+ Atlas) each get <local-part>@assembl.co.nz. Inbound mail is
# relayed by AgentMail to the agent-email-inbound edge function; outbound replies
# go FROM the agent's address via Brevo (reuses BREVO_API_KEY above).
#
# Go-live (external, see OVERNIGHT-BLOCKER-agent-email.md):
#   1. Authorise the assembl.co.nz DOMAIN in Brevo (SPF + DKIM + DMARC) so any
#      <slug>@assembl.co.nz can send. Without it Brevo rejects the FROM.
#   2. Point AgentMail (or your inbound relay) for *@assembl.co.nz at the
#      agent-email-inbound function and set the shared HMAC secret below.
#
# HMAC secret AgentMail signs inbound webhooks with (X-AgentMail-Signature).
# The agent-email-inbound function fails closed if this is unset.
AGENTMAIL_WEBHOOK_SECRET=""
# Optional: domain for agent addresses (default assembl.co.nz).
AGENT_EMAIL_DOMAIN="assembl.co.nz"
# Optional: 'true' to auto-acknowledge inbound mail ("Got your email…").
AGENT_EMAIL_AUTO_ACK="false"
# Shared token gating the agent-email-outbound edge function (Deno sender).
AGENT_EMAIL_OUTBOUND_TOKEN=""
# Token gating /admin/agent-email + the reply API. Falls back to LEADS_VIEW_TOKEN.
AGENT_EMAIL_ADMIN_TOKEN=""

# ── Stripe — agent marketplace + Connect payouts ──────────────────
# Live keys for the agent marketplace (subscriptions) and Stripe Connect
# (per-agent payouts). Account: acct_1TCqv7PXAX9ohARR. Set all in Vercel
# (Production + Preview + Development).
#   - STRIPE_SECRET_KEY        server-side; never exposed to the browser.
#   - NEXT_PUBLIC_STRIPE_...   publishable key, safe for the client.
#   - STRIPE_WEBHOOK_SECRET    signing secret for /api/stripe/webhooks.
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Flat per-agent + bundle ladder price ids — filled in by `npm run stripe:setup`
# (it prints them). Each maps to a plan in lib/billing/agent-pricing.ts via its
# lookup_key. The first 3 messages per agent are free (no Stripe product); after
# that the paywall offers these plans.
#   Per-Agent  NZ$15/mo   ·  Bundle 5  NZ$50   ·  Bundle 10 NZ$90
#   Bundle 20  NZ$150/mo  ·  All-Access NZ$250
NEXT_PUBLIC_STRIPE_PRICE_PER_AGENT_1500=""
NEXT_PUBLIC_STRIPE_PRICE_BUNDLE_5_5000=""
NEXT_PUBLIC_STRIPE_PRICE_BUNDLE_10_9000=""
NEXT_PUBLIC_STRIPE_PRICE_BUNDLE_20_15000=""
NEXT_PUBLIC_STRIPE_PRICE_ALL_ACCESS_25000=""
# Optional fallback origin for Connect onboarding return URLs in local dev
# (production derives the origin from request headers).
# NEXT_PUBLIC_SITE_URL="https://assembl.co.nz"

# ── Pipeline health monitoring (health-check-cron edge function + /admin/health) ──
# Shared secret used to (a) invoke the health-check-cron function manually
# (x-api-key header or Bearer) and (b) gate the /admin/health dashboard
# (?key=...). The 5-minute pg_cron schedule invokes it with the service-role
# key, so this is only needed for manual runs + the dashboard.
HEALTH_CHECK_API_KEY=""
# POST target for failure alerts (Slack/Discord/generic webhook). This is the
# IP-block-resilient channel: if Brevo blocks our IP, email alerts stop but the
# webhook still fires. Leave empty to disable the webhook leg.
HEALTH_ALERT_WEBHOOK_URL=""
