    "./registry.json": "./registry.json",
    "./cinema-hero": "./src/cinema-hero/index.tsx",
    "./sideways-story": "./src/sideways-story/index.tsx",
    "./object-assembly": "./src/object-assembly/index.tsx",
    "./aerial-world": "./src/aerial-world/index.tsx",
    "./agent-live": "./src/agent-live/index.tsx",
    "./wait-state": "./src/wait-state/index.tsx",
    "./editorial-type": "./src/editorial-type/index.tsx",
    "./camera-scroll": "./src/camera-scroll/index.tsx",
    "./particle-field": "./src/particle-field/index.tsx",
    "./nz-material": "./src/nz-material/tokens.css",
    "./nz-material/meta": "./src/nz-material/meta.json"
  },
  "files": [
    "src",
    "registry.json",
    "registry.schema.json",
    "README.md"
  ],
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
