{
  "name": "@assembl/registry",
  "version": "0.1.0",
  "description": "assembl Studio creative block registry — stubs for Creative Director PREVIEW v0. Intended install names: @assembl/<block>.",
  "license": "UNLICENSED",
  "author": "Kate Hudson <assembl@assembl.co.nz>",
  "type": "module",
