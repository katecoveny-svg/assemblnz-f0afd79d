{
  "manifest_version": 3,
  "name": "DO by assembl",
  "version": "1.1.0",
  "description": "Choose text, prepare a useful draft, review it and take it with you.",
  "action": { "default_title": "Open DO", "default_popup": "popup.html" },
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["https://www.assembl.co.nz/*"],
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
