{
  "manifest_version": 3,
  "name": "DO · make agent (assembl PREVIEW)",
  "version": "0.1.0",
  "description": "See something → ✦ make agent. DEMO preview for assembl DO Agent OS v0.",
  "action": {
    "default_title": "DO · make agent",
    "default_popup": "sidepanel.html"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["activeTab", "sidePanel", "storage", "scripting"],
  "host_permissions": ["http://localhost:3000/*", "http://127.0.0.1:3000/*"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
