{
  "manifest_version": 3,
  "name": "DO by assembl",
  "version": "1.2.0",
  "description": "Build writing and creative agents alongside your browser work. Capture selected text only when you choose.",
  "action": {
    "default_title": "Open DO"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "sidePanel"
  ],
  "host_permissions": [
    "https://www.assembl.co.nz/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "minimum_chrome_version": "116",
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
