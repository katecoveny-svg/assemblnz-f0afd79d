{
  "manifest_version": 3,
  "name": "DO browser pilot — fixture only",
  "version": "1.9.0",
  "description": "Review a two-minute connection to a fictional local cart. Real retailer access remains disabled.",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "scripting", "sidePanel"],
  "host_permissions": ["https://www.assembl.co.nz/*"],
  "action": { "default_title": "Review a DO browser connection", "default_icon": {"16":"icons/icon16.png","32":"icons/icon32.png","48":"icons/icon48.png"} },
  "icons": {"16":"icons/icon16.png","32":"icons/icon32.png","48":"icons/icon48.png","128":"icons/icon128.png"},
  "side_panel": {"default_path":"browser-connection.html"},
  "background": {"service_worker":"pilot-worker.js"}
}
