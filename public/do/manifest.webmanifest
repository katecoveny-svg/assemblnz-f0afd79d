    }
  ],
  "shortcuts": [
    {
      "name": "Open DO",
      "short_name": "DO",
      "url": "/do/personal",
      "description": "Notes, plans and drafts for everyday jobs."
    },
    {
      "name": "Ask DO",
      "short_name": "Ask",
      "url": "/do/ask",
      "description": "Say or type what you would like done. DO shows it for review first."
    },
    {
      "name": "Write with DO",
      "short_name": "Write",
      "url": "/do/widget?entry=write",
      "description": "Type or use your device dictation in the existing DO workspace."
    },
    {
      "name": "Talk with DO",
      "short_name": "Talk",
      "url": "/do/widget?entry=talk",
      "description": "Check live conversation availability. Review consent before starting."
    },
    {
      "name": "Meeting DO",
      "short_name": "Meeting",
      "url": "/do/meetings?phone=1",
      "description": "Open and record a meeting on your phone."
    }
  ]
