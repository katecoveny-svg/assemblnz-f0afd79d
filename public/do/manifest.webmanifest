{
  "id": "/do",
  "name": "DO by assembl",
  "short_name": "DO",
  "description": "Your portable work companion. Talk, record, prepare and review with permission. Draft-only tools; no automatic sends or purchases.",
  "start_url": "/do/widget",
  "scope": "/do",
  "display": "standalone",
  "display_override": [
    "standalone",
    "browser"
  ],
  "orientation": "any",
  "background_color": "#FFFDFB",
  "theme_color": "#240B21",
  "lang": "en-NZ",
  "dir": "ltr",
  "categories": [
    "productivity",
    "utilities",
    "business"
  ],
  "icons": [
    {
      "src": "/do/icons/do-192.png?v=3",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/do/icons/do-512.png?v=3",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/do/icons/do-192.png?v=3",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/do/icons/do-512.png?v=3",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "DO workspace",
      "short_name": "Workspace",
      "url": "/do/widget",
      "description": "Talk, prepare and review in your workspace."
    },
    {
      "name": "Meeting DO",
      "short_name": "Meeting",
      "url": "/do/meetings?phone=1",
      "description": "Open and record a meeting on your phone."
    },
    {
      "name": "Household Floor",
      "short_name": "Household",
      "url": "/do/household",
      "description": "Family seats, evening board, drafts only."
    },
    {
      "name": "DO Office",
      "short_name": "Office",
      "url": "/do/office",
      "description": "Coordinate specialist DOs in the office."
    },
    {
      "name": "Builder DO",
      "short_name": "Builder",
      "url": "/do/builder",
      "description": "Turn a software idea into a build job to review."
    },
    {
      "name": "Connections",
      "short_name": "Connect",
      "url": "/do/connections",
      "description": "Link the accounts DO may use with your approval."
    }
  ]
}
