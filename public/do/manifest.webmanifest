{
  "id": "/do",
  "name": "DO by assembl",
  "short_name": "DO",
  "description": "Notes, plans and drafts for everyday jobs. Made by assembl.",
  "start_url": "/do/personal",
  "scope": "/do",
  "share_target": {
    "action": "/do/receive",
    "method": "POST",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "display": "standalone",
  "display_override": [
    "standalone",
    "browser"
  ],
  "orientation": "any",
  "background_color": "#FFFDFB",
  "theme_color": "#240B21",
  "lang": "en-NZ",
  "dir": "ltr",
  "categories": [
    "productivity",
    "utilities",
    "business"
  ],
  "icons": [
