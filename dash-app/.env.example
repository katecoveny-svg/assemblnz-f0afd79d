# Copy this file to ".env.local" and fill in from your Supabase project (Project Settings > API).
# The app runs in DEMO MODE without these (no backend needed) — add them when you wire up Supabase.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Used only by Edge Functions (server-side). NEVER put the service-role key in NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=
