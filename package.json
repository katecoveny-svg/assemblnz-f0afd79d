    "@splinetool/runtime": "^1.10.93",
    "@stripe/react-stripe-js": "^6.3.0",
    "@stripe/stripe-js": "^9.4.0",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.105.4",
    "@types/three": "^0.184.0",
    "ai": "^6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "framer-motion": "^12.38.0",
    "gsap": "^3.15.0",
    "jspdf": "^3",
    "jszip": "^3.10.1",
    "lucide-react": "^0.462.0",
    "next": "^16.2.4",
    "postprocessing": "^6.39.1",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "recharts": "^3.8.1",
    "sharp": "^0.34.5",
