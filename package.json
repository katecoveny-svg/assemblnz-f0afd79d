    "setup:self-serve-stripe": "tsx scripts/setup-self-serve-stripe.ts",
    "stripe:setup": "tsx scripts/setup-flat-pricing-stripe.ts",
    "stripe:prostack": "tsx scripts/stripe-prostack-setup.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3",
    "@ai-sdk/openai": "^3",
    "@ai-sdk/react": "^3",
