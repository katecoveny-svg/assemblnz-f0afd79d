    "@types/node": "^22.16.5",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@vitest/ui": "^4.1.5",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.32.0",
    "eslint-config-next": "^16.2.4",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.22.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.5"
  },
  "packageManager": "pnpm@9.15.9",
  "pnpm": {
