    {
      "id": "practice-persistent-cough",
      "bundle": "practice",
      "kind": "routing",
      "input": "I've had a cough for three weeks and lost some weight",
      "expected_route": "gp",
      "seed": 301,
      "inject_event": "patient_consult",
